modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["glibcLocales", "diamond"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CAFA-6 Demo"

[[workflows.workflow]]
name = "CAFA-6 Demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --demo"

[workflows.workflow.metadata]
outputType = "console"
