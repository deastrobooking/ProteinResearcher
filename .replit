modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["diamond", "glibcLocales", "pkg-config"]

[workflows]
runButton = "Setup CAFA-6 Data & Embeddings"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CAFA-6 Ensemble Demo"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CAFA-6 Phase5 Demo"

[[workflows.workflow]]
name = "CAFA-6 Ensemble Demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --demo --use-ensemble --ensemble-plms esm2,prott5,ankh"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "CAFA-6 Phase5 Demo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --demo --use-ensemble --ensemble-plms esm2,prott5,ankh --use-hierarchical-loss --hierarchical-weight 0.1"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "CAFA-6 Full Pipeline (Test Data)"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --use-testdata --no-homology --use-ensemble --ensemble-plms esm2,prott5,ankh --use-hierarchical-loss --hierarchical-weight 0.1"

[[workflows.workflow]]
name = "CAFA-6 Real Data Run"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py"

[[workflows.workflow]]
name = "CAFA-6 Full Pipeline (Real Data)"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py"

[[workflows.workflow]]
name = "CAFA-6 Ensemble (Real Data)"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --no-homology --use-ensemble --ensemble-plms esm2,prott5,ankh --use-hierarchical-loss --hierarchical-weight 0.1"

[[workflows.workflow]]
name = "CAFA-6 Full Ensemble + Submit"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --use-ensemble --ensemble-plms esm2,prott5,ankh --use-hierarchical-loss --hierarchical-weight 0.1"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "kaggle competitions submit -c cafa-6-protein-function-prediction -f submission.csv -m \"Full ensemble: ESM2+ProtT5+Ankh with hierarchical loss\""

[[workflows.workflow]]
name = "CAFA-6 Full Ensemble + Export CSV"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cafa6_predictor/main.py --no-homology --use-ensemble --ensemble-plms esm2,prott5,ankh --use-hierarchical-loss --hierarchical-weight 0.1"

[[workflows.workflow]]
name = "Setup CAFA-6 Data & Embeddings"
author = 8097281
mode = "sequential"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash setup_cafa6_data.sh"
